# GitSafe OAuth credentials.
# Copy this file to `.env`, fill in the values, and restart the server.
GITSAFE_GITHUB_CLIENT_ID=
GITSAFE_GITHUB_CLIENT_SECRET=

# --- Google Drive OAuth (required to back repositories up to Google Drive) ---
GITSAFE_DRIVE_CLIENT_ID=
GITSAFE_DRIVE_CLIENT_SECRET=

# Optional local PostgreSQL backend. Production requires this value.
DATABASE_URL=
# Required when DATABASE_URL is set and in production.
GITSAFE_TOKEN_KEY=
# Used only by the local file-backed token fallback.
GITSAFE_DATA_DIR=

# Optional: dedicated key for signing session and OAuth-state cookies.
# Defaults to a key derived from GITSAFE_TOKEN_KEY (or a random per-process key
# locally, which signs you out on restart). Rotating it signs everyone out.
GITSAFE_SESSION_KEY=

# Optional: enables opt-in daily backups to Google Drive. The scheduler
# (.github/workflows/daily-backup.yml) sends it as a bearer token to
# POST /api/cron/backup. At least 32 characters: openssl rand -hex 32
GITSAFE_CRON_SECRET=

# Optional: trusted proxy header for rate limiting (e.g. CF-Connecting-IP,
# X-Real-IP, or X-Forwarded-For). When unset, rate limiting uses RemoteAddr.
GITSAFE_TRUSTED_PROXY_HEADER=
