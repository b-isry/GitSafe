# GitSafe OAuth credentials.
# Copy this file to `.env`, fill in the values, and restart the server.
GITSAFE_GITHUB_CLIENT_ID=
GITSAFE_GITHUB_CLIENT_SECRET=

# --- Google Drive OAuth (required to back repositories up to Google Drive) ---
GITSAFE_DRIVE_CLIENT_ID=
GITSAFE_DRIVE_CLIENT_SECRET=

# Optional local PostgreSQL backend. Production requires this value.
DATABASE_URL=
# Required when DATABASE_URL is set and in production.
GITSAFE_TOKEN_KEY=
# Used only by the local file-backed token fallback.
GITSAFE_DATA_DIR=
